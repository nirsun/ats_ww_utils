       "(7757, 17641, 14)"
      ]
     },
     "execution_count": 6,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "pressure_subsurface = visfile_subsurface.getArray('pressure')\n",
    "pressure_subsurface.shape # first dim is time, second dim is space, third is subsurface layers"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "a543e87f-5cfa-428d-8344-720c5820911d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# get the WTD (following surface mesh index)\n",
    "wtd_pressure_rearranged, surface_subsurface_IDs = get_ats_wtd_pressurebased(pressure_subsurface=pressure_subsurface,\n",
    "                                                                            visfile_surface=visfile_surface, \n",
    "                                                                            visfile_subsurface= visfile_subsurface,\n",
    "                                                                            surface_subsurface_IDs=None) # replace surface_subsurface_IDs=surface_subsurface_IDs if surface_subsurface_IDs is available"
   ]
  },
